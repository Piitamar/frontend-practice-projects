CHANNEL_PORT=3001
JWT_SECRET=replace-with-one-shared-secret-for-both-servers

# Use DATABASE_URL instead of the individual values when deploying.
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatapp

# Local PostgreSQL fallback values when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp
DB_USER=postgres
DB_PASSWORD=password
